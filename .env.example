# Owner role: migrations and ingest. Exempt from row-level security.
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# Retrieval role. MUST be NOBYPASSRLS — never the owner. The app refuses to start
# if this role can bypass row-level security.
APP_DATABASE_URL=postgresql+psycopg://rag_app:rag_app@localhost:5432/rag

CORPUS_DIR=corpus/seed
PERSONAS_FILE=evals/personas.yaml

# Ollama on the host: http://localhost:11434
# From inside the api container: http://host.docker.internal:11434
# Using the compose ollama service (make up-local-llm): http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# --- Model selection -------------------------------------------------------
# Which models exist, what they cost, and what classification each may see is
# defined in policy/models.yaml — not here. This only picks which registry entry
# to request; leave empty to use the registry's own default_model.
DEFAULT_MODEL=
# Registry entry the attribution judge (make judge) asks; empty = DEFAULT_MODEL,
# i.e. the judged model grades itself. Set it for an independent grader.
JUDGE_MODEL=
AWS_REGION=us-east-1

# Gemini Enterprise Agent Platform (formerly Vertex AI), used by registry entries
# with provider: vertex. Authenticate with Application Default Credentials:
#   gcloud auth application-default login
# or point GOOGLE_APPLICATION_CREDENTIALS at a service-account key that holds only
# the Vertex AI User role. Credentials never go in this file.
GCP_PROJECT=
GCP_LOCATION=us-central1

# --- Retrieval -------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=8
RETRIEVAL_MODE=hybrid
FETCH_K=20
RRF_K=60
VECTOR_WEIGHT=1.0
KEYWORD_WEIGHT=1.0
PREFER_ACTIVE=true
SUPERSEDED_PENALTY=0.3

# --- Prompt ----------------------------------------------------------------
# Wraps each context document in data fences and restates the instruction
# boundary after the context. Measured effect on the red team suite:
# 4/16 attacks succeed without it, 2/16 with it. See docs/FINDINGS.md.
CONTEXT_FENCING=true

# --- Gateway ---------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# --- Authentication --------------------------------------------------------
# persona: identity comes from the request body (development, evals, demo console).
# oidc:    identity comes from a verified bearer JWT; the body `user` is rejected and
#          the evidence/usage/verify endpoints require the admin group.
AUTH_MODE=persona
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=cp-admin
OIDC_LEEWAY_SECONDS=30

# --- Demo mode -------------------------------------------------------------
# For a publicly reachable instance; set DEMO_MODE=true to enable. Off by
# default: local development is unrestricted. See the Hosting section of the
# README.
DEMO_ALLOWED_MODELS=ollama/llama3.1:8b
DEMO_RATE_PER_MINUTE=6
DEMO_CANNED_ONLY=true
