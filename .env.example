# Host runs: localhost. Inside the api container, compose overrides this to db:5432.
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
COLLECTION=corpus_v1
CORPUS_DIR=corpus/seed

# Ollama already on the host: http://localhost:11434 from the host,
# http://host.docker.internal:11434 from the api container.
# Using the compose ollama service (make up-local-llm): http://ollama:11434 in-container.
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# ollama | bedrock
LLM_PROVIDER=ollama
OLLAMA_CHAT_MODEL=llama3.1:8b

# Bedrock: copy the exact Claude model or inference-profile ID from the Bedrock console.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1

CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
